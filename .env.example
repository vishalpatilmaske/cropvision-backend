# Backend configuration. Copy to .env for local development.
# On Vercel, set these in the backend project's Environment Variables instead.

# --- Flask ---
# development | production (production refuses weak SECRET_KEY / JWT_SECRET).
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_ENV=development
SECRET_KEY=
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12
# Frontend URL(s) allowed to call the API, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Local MongoDB, or MongoDB Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cropvision
# (MONGODB_URI also works as the name.)
MONGO_URI=mongodb://localhost:27017/cropvision

# --- OpenAI (crop image analysis, farm assistant) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# --- Email (SMTP) for farmer login codes ---
# Gmail: use an App Password (Google Account > Security > App passwords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=CropVision AI
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
RATE_LIMIT_OTP=5 per minute

# --- Sign in with Google (optional) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Add your frontend URL(s) to "Authorized JavaScript origins". Empty = Google sign-in off.
GOOGLE_CLIENT_ID=

# --- Admin panel login ---
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=change-me

# --- Weather + place lookup (Open-Meteo, no key needed) ---
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
CLIMATE_API_URL=https://archive-api.open-meteo.com/v1/archive

# --- Production (Vercel) ---
# TRUST_PROXY=true
# RATELIMIT_STORAGE_URI=<same value as MONGO_URI>  (shares rate limits across instances)

# --- Uploads / rate limits ---
MAX_UPLOAD_SIZE_BYTES=8388608
MAX_IMAGE_DIMENSION_PX=1600
RATE_LIMIT_ANALYZE=10 per minute
RATE_LIMIT_CHAT=20 per minute
